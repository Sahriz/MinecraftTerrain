#version 430 core

//Enable the 16-bit storage extension
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer NoiseBuffer{
	uint16_t blockIDs[];
};

layout(std430, binding = 2) buffer IndexBuffer{
    uint16_t indices[];
};

layout(std430, binding = 3) buffer IndirectBuffer {
    uint count;         // Number of vertices to draw
    uint instanceCount; // Usually 1
    uint first;         // Always 0
    uint baseVertex;    // Always 0
    uint baseInstance;  // Always 0
};

layout(std430, binding = 4) buffer VertexCounterBuffer{
    int vertexCounter;
};

layout(std430, binding = 5) buffer TotalActiveCount {
	uint totalActiveCount;
};

layout(std430, binding = 6) buffer ActiveVoxelList { uint activeVoxels[]; };

layout(std430, binding = 7) buffer packedBuffer{
    uint packedData[];
};




vec3[] cornerOffset = { vec3(0.0f,0.0f, 0.0f), vec3(1.0f, 0.0f, 0.0f),
								vec3(1.0f, 0.0f, 1.0f),vec3(0.0f, 0.0f, 1.0f),
								vec3(0.0f, 1.0f, 0.0f), vec3(1.0f, 1.0f, 0.0f),
								vec3(1.0f, 1.0f, 1.0f),  vec3(0.0f, 1.0f, 1.0f)};

uniform int gridWidth; 
uniform int gridHeigth;
uniform int gridDepth;
uniform vec3 offset;

uniform float columns;
uniform float rows;



bool IsSolid(int x, int y, int z) {
    int index = x + y * gridWidth + z * gridWidth * gridHeigth;
    return uint(blockIDs[index]) > 0u;
}

 // Normals for each face
    const uint faceNormals[6] = uint[](
        0x0u, 0x1u, 0x2u, 0x3u, 0x4u, 0x5u
        
    );

    const uint u[4] = uint[](0, 1, 1, 0); 
    const uint v[4] = uint[](0, 0, 1, 1);

void main(){

	 uint listIdx = gl_GlobalInvocationID.x;

	if (listIdx >= totalActiveCount) return;

	uint packedID = activeVoxels[listIdx];
	ivec3 position;
	position.x = int(packedID & 0x3FF);
    position.y = int((packedID >> 10) & 0x3FF);
    position.z = int((packedID >> 20) & 0x3FF);    
    
    vec3 base = vec3(position);
    float tileW = 1.0 / columns;
    float tileH = 1.0 / rows;

    uint blockType = uint(blockIDs[position.x + position.y * gridWidth + position.z * gridWidth * gridHeigth]);
    
    ivec3 dirs[6] = ivec3[](
        ivec3(1,0,0), ivec3(-1,0,0), ivec3(0,1,0), ivec3(0,-1,0), ivec3(0,0,1), ivec3(0,0,-1)
    );

   

    for (int f = 0; f < 6; f++) {
        ivec3 neighborPos = position + dirs[f];
    
        if (!IsSolid(neighborPos.x, neighborPos.y, neighborPos.z)) {
        
            // 1. Reserve 4 vertices and 6 indices
            int vStart = atomicAdd(vertexCounter, 4);
            uint iStart = atomicAdd(count, 6);

            // 2. Define geometry (Winding order maintained)
            vec3 vert[4];
            if (f == 0) { // +X (Right)
                vert[0] = base + cornerOffset[1]; vert[1] = base + cornerOffset[2];
                vert[2] = base + cornerOffset[6]; vert[3] = base + cornerOffset[5];
            } else if (f == 1) { // -X (Left)
                vert[0] = base + cornerOffset[3]; vert[1] = base + cornerOffset[0];
                vert[2] = base + cornerOffset[4]; vert[3] = base + cornerOffset[7];
            } else if (f == 2) { // +Y (Top)
                vert[0] = base + cornerOffset[4]; vert[1] = base + cornerOffset[5];
                vert[2] = base + cornerOffset[6]; vert[3] = base + cornerOffset[7];
            } else if (f == 3) { // -Y (Bottom)
                vert[0] = base + cornerOffset[3]; vert[1] = base + cornerOffset[2];
                vert[2] = base + cornerOffset[1]; vert[3] = base + cornerOffset[0];
            } else if (f == 4) { // +Z (Front)
                vert[0] = base + cornerOffset[2]; vert[1] = base + cornerOffset[3];
                vert[2] = base + cornerOffset[7]; vert[3] = base + cornerOffset[6];
            } else if (f == 5) { // -Z (Back)
                vert[0] = base + cornerOffset[0]; vert[1] = base + cornerOffset[1];
                vert[2] = base + cornerOffset[5]; vert[3] = base + cornerOffset[4];
            }

            // 3. UV calculation (Top-Left, Bottom-Left, etc.)
            float colIdx = 1.0; // Default to 1.0 for now, or use your logic
            if (f == 2) colIdx = 0.0;      // Top face (Grass)
            else if (f == 3) colIdx = 2.0; // Bottom face (Dirt)

            

            // 4. Write to Interleaved Buffer (Matching vec4 struct)
            for (int i = 0; i < 4; i++) {

                vec3 unpackedVert = vert[i];
                uint x = uint(unpackedVert.x) & 0x1Fu;
                uint y = uint(unpackedVert.y) & 0x1FFu;
                uint z = uint(unpackedVert.z) & 0x1Fu;
                uint packed = (z << 14) | (y << 5) | x;
                
                uint unpackedNormal = faceNormals[f];

                packed |= unpackedNormal << 19;

                uint unpackedU = u[i];
                uint unpackedV =  v[i];

                packed |= (unpackedU << 22);
                packed |= (unpackedV << 23); 

                uint textureIndex = blockType & 0xFFu;
                
                packed |= (textureIndex << 24);

                packedData[vStart+i] = packed;
                // Standard UV layout for a quad
            }
            

            // 5. Write to Index Buffer
            indices[iStart + 0] = uint16_t(vStart + 0);
            indices[iStart + 1] = uint16_t(vStart + 2);
            indices[iStart + 2] = uint16_t(vStart + 1);
            indices[iStart + 3] = uint16_t(vStart + 0);
            indices[iStart + 4] = uint16_t(vStart + 3);
            indices[iStart + 5] = uint16_t(vStart + 2);
        }
    }
}