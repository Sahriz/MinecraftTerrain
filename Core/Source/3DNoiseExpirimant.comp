#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) buffer noiseBuffer {
    float noiseMap[];
};

uniform int width;
uniform int height;
uniform int depth;
uniform vec3 offset;

uniform float frequency;
uniform bool useHeightDropoff;

/* discontinuous pseudorandom uniformly distributed in [-0.5, +0.5]^3 */
vec3 random3(vec3 c) {
	float j = 4096.0*sin(dot(c,vec3(17.0, 59.4, 15.0)));
	vec3 r;
	r.z = fract(512.0*j);
	j *= .125;
	r.x = fract(512.0*j);
	j *= .125;
	r.y = fract(512.0*j);
	return r-0.5;
}

const float F3 =  0.3333333;
const float G3 =  0.1666667;
float snoise(vec3 p) {

	vec3 s = floor(p + dot(p, vec3(F3)));
	vec3 x = p - s + dot(s, vec3(G3));

	vec3 e = step(vec3(0.0), x - x.yzx);
	vec3 i1 = e*(1.0 - e.zxy);
	vec3 i2 = 1.0 - e.zxy*(1.0 - e);

	vec3 x1 = x - i1 + G3;
	vec3 x2 = x - i2 + 2.0*G3;
	vec3 x3 = x - 1.0 + 3.0*G3;

	vec4 w, d;

	w.x = dot(x, x);
	w.y = dot(x1, x1);
	w.z = dot(x2, x2);
	w.w = dot(x3, x3);

	w = max(0.6 - w, 0.0);

	d.x = dot(random3(s), x);
	d.y = dot(random3(s + i1), x1);
	d.z = dot(random3(s + i2), x2);
	d.w = dot(random3(s + 1.0), x3);

	w *= w;
	w *= w;
	d *= w;

	return dot(d, vec4(52.0));
}

vec3 mod289(vec3 x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

vec2 mod289(vec2 x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

vec3 permute(vec3 x) {
    return mod289(((x * 34.0) + 1.0) * x);
}

float snoise2D(vec2 v) {
    const vec4 C = vec4(0.211324865405187,
                        0.366025403784439,
                       -0.577350269189626,
                        0.024390243902439);
    vec2 i  = floor(v + dot(v, C.yy));
    vec2 x0 = v - i + dot(i, C.xx);

    vec2 i1;
    i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    vec4 x12 = x0.xyxy + C.xxzz;
    x12.xy -= i1;

    i = mod289(i);
    vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0))
           + i.x + vec3(0.0, i1.x, 1.0));

    vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
    m = m * m;
    m = m * m;

    vec3 x = 2.0 * fract(p * C.www) - 1.0;
    vec3 h = abs(x) - 0.5;
    vec3 ox = floor(x + 0.5);
    vec3 a0 = x - ox;

    m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);

    vec3 g;
    g.x  = a0.x  * x0.x  + h.x  * x0.y;
    g.yz = a0.yz * x12.xz + h.yz * x12.yw;
    return 130.0 * dot(m, g);
}

float snoiseFractal(vec3 m) {
	return   0.5333333* snoise(m)
				+0.2666667* snoise(2.0*m)
				+0.1333333* snoise(4.0*m)
				+0.0666667* snoise(8.0*m);
}

void main(){
	uint xPos = gl_GlobalInvocationID.x;
	uint yPos = gl_GlobalInvocationID.y;
	uint zPos = gl_GlobalInvocationID.z;

	if(xPos >= uint(width) || yPos >= uint(height) || zPos >= uint(depth)) return;

	// Each low-res sample covers 2 full-res voxels (stride = 2).
	// offset is pre-shifted by -1 so index 0 aligns to padded position -1 in world space,
	// ensuring sample points land on odd padded positions (1, 3, ..., 17) which are
	// shared consistently between adjacent chunks.
	float worldX = float(int(xPos) * 2) + offset.x;
	float worldY = float(int(yPos) * 2) + offset.y;
	float worldZ = float(int(zPos) * 2) + offset.z;

	vec2 worldPos2D = vec2(worldX, worldZ);

	// Recover the effective full-res padded height for terrain scale calculations.
	// lowResHeight = paddedHeight / 2 + 1, so paddedHeight = (lowResHeight - 1) * 2.
	int effectiveHeight = (height - 1) * 2;

    float continental = snoise2D(worldPos2D * 0.0008);
    continental = 0.63*smoothstep(-0.2, 0.5, continental);

    float erosion = snoise2D(worldPos2D*0.002);
    erosion = -40*max(smoothstep(-0.15, 0.05, erosion), smoothstep(0.05, -0.15, erosion));

    float continentalBackwards = max(0.0, 0.63-continental);

    float mountainDetail = 0.0;
    float f = 0.002;
    float a = 1.0;
    for(int i = 0; i < 5; i++) {
        float n = snoise2D(worldPos2D * f);
        mountainDetail += (1.0 - abs(n)) * a;
        f *= 2.0;
        a *= 0.5;
    }

	float surfaceHeight = 0.0;
    float f2D = 0.0005;
    float a2D = 1.0;
    float totalAmplitude = 0.0;

	for(int i = 0; i < 4; i++) {
        surfaceHeight += a2D * snoise2D(worldPos2D * f2D);
        totalAmplitude += a2D;
        f2D *= 2.0;
        a2D *= 0.5;
    }

    surfaceHeight = (surfaceHeight / totalAmplitude) * 0.5 + 0.5;

    float erosionVariation = erosion * (max(0.0, continentalBackwards - 0.0));
	float finalTerrainHeight = (effectiveHeight * 0.2) + (mountainDetail * (effectiveHeight * 0.6) * continental) - erosionVariation;

    float density = finalTerrainHeight - worldY;

    float overhangNoise = snoise(vec3(worldX, worldY, worldZ) * 0.02) * 20.0;
    density += overhangNoise * continental;

    uint index = xPos + yPos * uint(width) + zPos * uint(width) * uint(height);

	vec3 position3D = vec3(worldX, worldY, worldZ);

    float caveNoise = 0.0;
    float f3D = 0.01;
    float a3D = 1.0;

    for(int i = 0; i < 3; i++) {
        caveNoise += a3D * snoise(position3D * f3D);
        f3D *= 2.0;
        a3D *= 0.5;
    }

	float normalizedHeight = max(0.0, worldY) / max(1.0, finalTerrainHeight);

    float bottomThreshold = -0.1;
    float topThreshold = 0.6;
    float caveThreshold = mix(bottomThreshold, topThreshold, pow(normalizedHeight, 2.0));

    // Carve caves into the continuous density field instead of hard-writing a
    // constant. How far caveNoise sits past the threshold drives a smooth 0..1
    // strength; we blend the density toward a solidly-negative "air" value. The
    // field stays smooth, so the interpolation pass can place cave walls anywhere
    // between samples. The old "noiseMap = -1.0" wrote a flat, discontinuous
    // plateau that interpolation could only resolve on the stride-2 grid.
    float caveStrength = smoothstep(0.0, 0.2, caveNoise - caveThreshold);
    density = mix(density, -64.0, caveStrength);

    noiseMap[index] = density;
}
