#version 430 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) buffer noiseBuffer {
    float noiseMap[];
};

uniform int width;
uniform int height;
uniform int depth;
uniform vec3 offset;

uniform float frequency;
uniform bool useHeightDropoff;

/* discontinuous pseudorandom uniformly distributed in [-0.5, +0.5]^3 */
vec3 random3(vec3 c) {
	float j = 4096.0*sin(dot(c,vec3(17.0, 59.4, 15.0)));
	vec3 r;
	r.z = fract(512.0*j);
	j *= .125;
	r.x = fract(512.0*j);
	j *= .125;
	r.y = fract(512.0*j);
	return r-0.5;
}

const float F3 =  0.3333333;
const float G3 =  0.1666667;
float snoise(vec3 p) {

	vec3 s = floor(p + dot(p, vec3(F3)));
	vec3 x = p - s + dot(s, vec3(G3));

	vec3 e = step(vec3(0.0), x - x.yzx);
	vec3 i1 = e*(1.0 - e.zxy);
	vec3 i2 = 1.0 - e.zxy*(1.0 - e);

	vec3 x1 = x - i1 + G3;
	vec3 x2 = x - i2 + 2.0*G3;
	vec3 x3 = x - 1.0 + 3.0*G3;

	vec4 w, d;

	w.x = dot(x, x);
	w.y = dot(x1, x1);
	w.z = dot(x2, x2);
	w.w = dot(x3, x3);

	w = max(0.6 - w, 0.0);

	d.x = dot(random3(s), x);
	d.y = dot(random3(s + i1), x1);
	d.z = dot(random3(s + i2), x2);
	d.w = dot(random3(s + 1.0), x3);

	w *= w;
	w *= w;
	d *= w;

	return dot(d, vec4(52.0));
}

vec3 mod289(vec3 x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

vec2 mod289(vec2 x) {
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

vec3 permute(vec3 x) {
    return mod289(((x * 34.0) + 1.0) * x);
}

float snoise2D(vec2 v) {
    const vec4 C = vec4(0.211324865405187,
                        0.366025403784439,
                       -0.577350269189626,
                        0.024390243902439);
    vec2 i  = floor(v + dot(v, C.yy));
    vec2 x0 = v - i + dot(i, C.xx);

    vec2 i1;
    i1 = (x0.x > x0.y) ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
    vec4 x12 = x0.xyxy + C.xxzz;
    x12.xy -= i1;

    i = mod289(i);
    vec3 p = permute(permute(i.y + vec3(0.0, i1.y, 1.0))
           + i.x + vec3(0.0, i1.x, 1.0));

    vec3 m = max(0.5 - vec3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
    m = m * m;
    m = m * m;

    vec3 x = 2.0 * fract(p * C.www) - 1.0;
    vec3 h = abs(x) - 0.5;
    vec3 ox = floor(x + 0.5);
    vec3 a0 = x - ox;

    m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);

    vec3 g;
    g.x  = a0.x  * x0.x  + h.x  * x0.y;
    g.yz = a0.yz * x12.xz + h.yz * x12.yw;
    return 130.0 * dot(m, g);
}

float snoiseFractal(vec3 m) {
	return   0.5333333* snoise(m)
				+0.2666667* snoise(2.0*m)
				+0.1333333* snoise(4.0*m)
				+0.0666667* snoise(8.0*m);
}

// Fractal Brownian motion: sum octaves at doubling frequency, halving amplitude.
// Normalized back to ~[-1, 1].
float fbm2D(vec2 p, int octaves) {
	float sum   = 0.0;
	float amp   = 1.0;
	float total = 0.0;
	for (int i = 0; i < octaves; i++) {
		sum   += amp * snoise2D(p);
		total += amp;
		p     *= 2.0;
		amp   *= 0.5;
	}
	return sum / total;
}

// Terrain splines, Minecraft-style. All control points share one array; each spline
// is a [start, start+count) slice of (input, output) points, sorted by input (.x).
// Edit the numbers and re-run to retune - shaders compile at runtime.
const vec2 SPLINES[] = vec2[](
	// Continentalness -> base surface height (world Y). Assumes Y in [0,256], sea ~90.
	vec2(-1.2, 50.0), vec2(-0.4, 70.0), vec2(-0.1, 70.0), vec2(0.1, 82.0),
	vec2(0.3, 92.0), vec2(0.6, 125.0), vec2(1.0, 160.0),
	// Erosion -> flatness (0 = rough/mountainous, 1 = flat).
	vec2(-1.0, 0.0), vec2(-0.4, 0.2), vec2(0.0, 0.5), vec2(0.4, 0.8), vec2(1.0, 1.0),
	// Peaks & valleys -> ridge strength (~ -1..1).
	vec2(-1.0, -0.6), vec2(-0.2, 0.0), vec2(0.2, 0.2), vec2(0.6, 0.7), vec2(1.0, 1.0)
);
const int CONT_START = 0,  CONT_COUNT = 7;
const int ERO_START  = 7,  ERO_COUNT  = 5;
const int PV_START   = 12, PV_COUNT   = 5;

// Piecewise-linear lookup over SPLINES[start .. start+count). Clamps past the ends.
float sampleCurve(float v, int start, int count) {
	int last = start + count - 1;
	if (v <= SPLINES[start].x) return SPLINES[start].y;
	if (v >= SPLINES[last].x)  return SPLINES[last].y;
	for (int i = start; i < last; i++) {
		if (v >= SPLINES[i].x && v < SPLINES[i + 1].x) {
			float t = (v - SPLINES[i].x) / (SPLINES[i + 1].x - SPLINES[i].x);
			return mix(SPLINES[i].y, SPLINES[i + 1].y, t);
		}
	}
	return SPLINES[last].y;
}

// Snap height into flat plateaus joined by steep faces (the basis for cliffs).
// step = plateau spacing = cliff height. riser = climb fraction per step
// (small = sheer faces, large = gentle ramps).
float terrace(float h, float step, float riser) {
	float level = floor(h / step);
	float t     = fract(h / step);
	return (level + smoothstep(1.0 - riser, 1.0, t)) * step;
}

void main(){
	uint xPos = gl_GlobalInvocationID.x;
	uint yPos = gl_GlobalInvocationID.y;
	uint zPos = gl_GlobalInvocationID.z;

	if(xPos >= uint(width) || yPos >= uint(height) || zPos >= uint(depth)) return;

	// Each low-res sample covers 2 voxels (stride 2). offset is pre-shifted by -1 so
	// samples land on odd padded positions (1, 3, ..., 17), shared between neighbor chunks.
	float worldX = float(int(xPos) * 2) + offset.x;
	float worldY = float(int(yPos) * 2) + offset.y;
	float worldZ = float(int(zPos) * 2) + offset.z;

	vec2 worldPos2D = vec2(worldX, worldZ);

	// --- 1. Parameters: four independent 2D noises, each roughly [-1, 1] ---
	float C  = fbm2D(worldPos2D * 0.00025, 2); // continentalness: ocean <-> inland
	float E  = fbm2D(worldPos2D * 0.001,  4); // erosion: high = flat, low = mountainous
	float W  = fbm2D(worldPos2D * 0.002,  4); // weirdness
	float PV = 1.0 - abs(3.0 * abs(W) - 2.0); // peaks & valleys, derived from weirdness

	// --- 2. Splines: map each parameter through its tunable curve ---
	float baseHeight = sampleCurve(C,  CONT_START, CONT_COUNT); // target surface height (world Y)
	float flatness   = sampleCurve(E,  ERO_START,  ERO_COUNT);  // 0 = rough, 1 = flat
	float peak       = sampleCurve(PV, PV_START,   PV_COUNT);   // ridge strength, ~ -1..1

	// --- 3. Combine into a height offset and vertical squash factor ---
	// Erosion suppresses peaks and raises the squash factor, so flat biomes stay flat.
	float offsetH = baseHeight + peak * 60.0 * (1.0 - flatness);
	float factor  = mix(0.12, 0.30, flatness); // stronger downward pull, even in mountains

	// Cliffs: a low-freq mask picks out "cliff regions" where the surface snaps into
	// plateaus. Gated by (1-flatness) so plains stay smooth. step = cliff height;
	// the smoothstep thresholds set how common cliffs are; 0.0015 sets their size.
	float cliffMask = smoothstep(0.5, 0.7, fbm2D(worldPos2D * 0.0015, 3)) * (1.0 - flatness);
	float terraced  = terrace(offsetH, 30.0, 0.08);
	offsetH         = mix(offsetH, terraced, cliffMask);

	// --- 4. Density: vertical gradient (shaped by factor) plus 3D detail ---
	// Surface = where density crosses zero. 3D detail bumps it; two clamps keep it sane:
	//   roughness - floors flat ground so it isn't dead smooth, caps tall terrain.
	//   taper     - detail fades to zero ~45 blocks from the surface, so nothing
	//               floats or punches a hole down to the void.
	float density = (offsetH - worldY) * factor;
	float detail  = snoiseFractal(vec3(worldX, worldY, worldZ) * 0.01);

	float roughness = mix(0.15, 1.0, 1.0 - flatness) * mix(1.0, 0.25, cliffMask); // ease off in cliff regions to keep faces crisp
	float taper     = clamp(1.0 - abs(worldY - offsetH) / 45.0, 0.0, 1.0);
	density += detail * 10.0 * roughness * taper;

	uint index = xPos + yPos * uint(width) + zPos * uint(width) * uint(height);
	noiseMap[index] = density;
}
