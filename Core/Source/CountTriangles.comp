#version 430 core

//Enable the 16-bit storage extension
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

// Compute shader - one thread per cube
layout(local_size_x = 64) in;

layout(std430, binding = 0) buffer noiseBuffer {
    uint16_t noiseMap[];
};

// Edge array: stores vertex index for each potential edge
layout(std430, binding = 1) buffer CounterBuffer {
    int counter;  
};

layout(std430, binding = 2) buffer TotalActiveCount {
	uint totalActiveCount;
};

layout(std430, binding = 3) buffer ActiveVoxelList {
    uint activeVoxels[]; 
};

uniform int gridWidth; 
uniform int gridHeigth;
uniform int gridDepth;
uniform vec3 offset;
uniform int meshMode; // 0 = terrain (faces vs air or water), 1 = water (faces vs air only)

bool IsSolid(int x, int y, int z) {
    int index = x + y * gridWidth + z * gridWidth * gridHeigth;
    return uint(noiseMap[index]) > 0u;
}

// Emit a face toward neighbour (x,y,z)? Terrain shows faces against air or water,
// water only against air. Must match GeometryInit's FaceVisible exactly, or the
// counted and built face totals disagree and the buffer over/underfills.
bool FaceVisible(int x, int y, int z) {
    uint id = uint(noiseMap[x + y * gridWidth + z * gridWidth * gridHeigth]);
    if (meshMode == 1) return id == 0u;
    return (id == 0u) || (id == 5u);
}

void main() {
    uint listIdx = gl_GlobalInvocationID.x;

	if (listIdx >= totalActiveCount) return;

	uint packedID = activeVoxels[listIdx];
	vec3 position;
	position.x = float(packedID & 0x3FF);
    position.y = float((packedID >> 10) & 0x3FF);
    position.z = float((packedID >> 20) & 0x3FF);    

    if (!IsSolid(int(position.x), int(position.y), int(position.z))) return;
    
    vec3 base = vec3(int(position.x),int(position.y),int(position.z)) + vec3(offset.x, offset.y, offset.z);
    
    if (FaceVisible(int(position.x) + 1, int(position.y), int(position.z)))
    {
        atomicAdd(counter, 1);
    }
    if (FaceVisible(int(position.x) - 1, int(position.y), int(position.z)))
    {
        atomicAdd(counter, 1);
    }

    if (FaceVisible(int(position.x), int(position.y) + 1, int(position.z)))
    {
        atomicAdd(counter, 1);
    }
    if (FaceVisible(int(position.x), int(position.y) - 1, int(position.z)))
    {
        atomicAdd(counter, 1);
    }

    if (FaceVisible(int(position.x), int(position.y), int(position.z) + 1))
    {
        atomicAdd(counter, 1);
    }
    if (FaceVisible(int(position.x), int(position.y), int(position.z) - 1))
    {
        atomicAdd(counter, 1);
    }
}